# Neon: DATABASE_URL = pooled (app y seed), DATABASE_URL_UNPOOLED = directa (migraciones)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk: claves del application en el Dashboard (API keys). La secreta nunca va al cliente.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk: webhook user.* (Dashboard > Webhooks > Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk: rutas de ingreso y registro de la app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe: cuenta de EE. UU. en modo prueba (Dashboard > Developers > API keys). La secreta nunca va al cliente.
STRIPE_SECRET_KEY=
# Tipo de cambio fijo (soles por dólar) para cobrar en USD en Stripe. Simulación: 3.75
PEN_PER_USD=3.75

# Vercel Blob: token del store de imágenes (Vercel > Storage > Blob; `vercel env pull .env.local` lo baja). Solo servidor.
BLOB_READ_WRITE_TOKEN=

# WhatsApp de contacto del CTA de Inicio (solo dígitos con código de país, ej. 51999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=
