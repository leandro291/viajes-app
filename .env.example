# Neon: DATABASE_URL = pooled (app y seed), DATABASE_URL_UNPOOLED = directa (migraciones)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk: claves del application en el Dashboard (API keys). La secreta nunca va al cliente.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk: webhook user.* (Dashboard > Webhooks > Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=
# Clerk: rutas de ingreso y registro de la app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
